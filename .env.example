# nano-qwen3tts-vllm minimal env example
# Recommended production pattern: one container = one exact Qwen model.
# Advanced defaults like USE_ZMQ and HF_HOME are intentionally omitted here.

API_KEY=qwen-dev-key
QWEN_TTS_PORT=8012
QWEN_VOICE_STORAGE_DIR=/app/runtime/qwen_voices
QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# Multi-model setups only:
# QWEN_ALLOWED_MODELS=base
# QWEN_TTS_ALLOWED_MODELS=base
# QWEN_TTS_ALLOWED_MODELS=Qwen/Qwen3-TTS-12Hz-0.6B-Base,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
