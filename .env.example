# nano-qwen3tts-vllm runtime configuration example
#
# Recommended production pattern:
# - one container exposes one exact Qwen model
# - shared voice storage volume persists across restarts/model switches
#
# Copy to .env and adjust the model selection.

USE_ZMQ=1
API_KEY=qwen-dev-key
QWEN_TTS_PORT=8012
HF_HOME=/root/.cache/huggingface
QWEN_VOICE_STORAGE_DIR=/app/runtime/qwen_voices

# Option A: expose one exact runtime model (recommended)
QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# Option B: expose a family or exact allowlist instead of a single model.
# Leave empty when QWEN3_TTS_MODEL_PATH is used.
QWEN_TTS_ALLOWED_MODELS=

# Exact single-model examples:
# QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# QWEN3_TTS_MODEL_PATH=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

# Family / allowlist examples:
# QWEN3_TTS_MODEL_PATH=
# QWEN_TTS_ALLOWED_MODELS=base
# QWEN_TTS_ALLOWED_MODELS=voice_design
# QWEN_TTS_ALLOWED_MODELS=customvoice
# QWEN_TTS_ALLOWED_MODELS=Qwen/Qwen3-TTS-12Hz-0.6B-Base,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
